<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pixel_bg_primary">

    <!-- 像素风扫描线装饰 -->
    <View
        android:id="@+id/splashScanLine"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/pixel_accent_neon"
        android:alpha="0.6" />

    <!-- 中心内容 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- 像素风图标 -->
        <ImageView
            android:id="@+id/splashIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_pixel_app_icon"
            android:contentDescription="@string/app_name" />

        <View android:layout_width="0dp" android:layout_height="20dp" />

        <!-- 应用名称 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/pixel_text_primary"
            android:textSize="22sp"
            android:letterSpacing="0.1"
            android:fontFamily="monospace" />

        <View android:layout_width="0dp" android:layout_height="8dp" />

        <!-- 副标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="实时障碍检测助手"
            android:textColor="@color/pixel_accent_primary"
            android:textSize="13sp"
            android:fontFamily="monospace" />

    </LinearLayout>

    <!-- 底部版本号 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:text="v1.2"
        android:textColor="@color/pixel_text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace" />

</FrameLayout>
