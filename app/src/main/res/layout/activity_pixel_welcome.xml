<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F0">

    <com.tencent.yolov11ncnn.view.DottedGridView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/scanLine"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:alpha="0.4"
        android:background="@drawable/bg_scan_line" />

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingRight="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neo_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingTop="36dp"
            android:paddingRight="28dp"
            android:paddingBottom="36dp">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_neo_icon">

                <ImageView
                    android:id="@+id/appIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="应用图标"
                    android:src="@drawable/ic_pixel_app_icon" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.05"
                android:text="@string/app_name"
                android:textColor="#1A1A2E"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="为视障用户提供实时环境感知与语音引导"
                android:textColor="#5A5A6E"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="#2D2D3A" />

            <Button
                android:id="@+id/btnStart"
                android:layout_width="200dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_neo_primary"
                android:contentDescription="@string/pixel_start_desc"
                android:stateListAnimator="@null"
                android:text="@string/pixel_start_experience"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:text="@string/pixel_tap_hint"
        android:textColor="#9E9E9E"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/voiceIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_neo_card"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_pixel_volume" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/pixel_voice_playing"
            android:textColor="#1A1A2E"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
