<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F0">

    <com.tencent.yolov11ncnn.view.DottedGridView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="80dp"
        android:paddingRight="32dp"
        android:paddingBottom="160dp">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_neo_icon">

            <ImageView
                android:id="@+id/onboardingIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="当前引导步骤图标"
                android:src="@drawable/ic_pixel_camera" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="32dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neo_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingTop="28dp"
            android:paddingRight="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/onboardingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="手机姿态"
                android:textColor="#1A1A2E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="#2D2D3A" />

            <TextView
                android:id="@+id/onboardingDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.6"
                android:text="请保持手机竖直，并让摄像头朝向前方。"
                android:textColor="#5A5A6E"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="16dp"
        android:paddingRight="32dp"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot0"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="#E53935" />

            <View
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="#9E9E9E" />

            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="#9E9E9E" />

            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:background="#9E9E9E" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="24dp" />

        <Button
            android:id="@+id/btnOnboardingNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_neo_primary"
            android:contentDescription="@string/onboarding_next_desc"
            android:stateListAnimator="@null"
            android:text="@string/onboarding_next"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/onboarding_tap_hint"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />
    </LinearLayout>

</FrameLayout>
