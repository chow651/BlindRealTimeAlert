<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F0">

    <SurfaceView
        android:id="@+id/cameraview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#08F5F5F0" />

    <View
        android:id="@+id/previewScanLine"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:alpha="0.28"
        android:background="@drawable/bg_scan_line" />

    <LinearLayout
        android:id="@+id/topStatusPanel"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_neo_card"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/systemStatusIndicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="#22C55E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="系统运行中"
                android:textColor="#1A1A2E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="运行:0s | 移动 | 正常"
            android:textColor="#5A5A6E"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/movementStatusButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neo_chip"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingTop="6dp"
            android:paddingRight="8dp"
            android:paddingBottom="6dp"
            android:text="状态: 移动"
            android:textColor="#1A1A2E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonSwitchCpuGpu"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_neo_secondary"
            android:stateListAnimator="@null"
            android:text="当前模式：GPU"
            android:textColor="#1A1A2E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonSwitchCamera"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_neo_secondary"
            android:stateListAnimator="@null"
            android:text="切换摄像头"
            android:textColor="#1A1A2E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/badgeVoiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/voiceStatusBubble"
                android:layout_width="74dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_voice_badge_idle_neo"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingLeft="8dp"
                android:paddingTop="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pixel_mic" />

                <TextView
                    android:id="@+id/tvVoiceBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="语音&#10;待命"
                    android:textColor="#1A1A2E"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/buttonActiveQuery"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_neo_secondary"
            android:gravity="center"
            android:stateListAnimator="@null"
            android:text="主动&#10;查询"
            android:textColor="#1A1A2E"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/voicePromptBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neo_card"
            android:gravity="center"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="12dp"
            android:paddingRight="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvVoiceHoldHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="当前提示：持续检测前方环境，可按住说话主动查询"
                android:textColor="#1A1A2E"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonHoldToTalk"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_neo_primary"
            android:stateListAnimator="@null"
            android:text="按住说话"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Spinner
        android:id="@+id/spinnerModel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</FrameLayout>
